# At least one provider key is required. If both are set, Groq is tried first
# and Gemini is the automatic fallback.

# Groq – free key at https://console.groq.com/keys (very fast)
GROQ_API_KEY=
# Optional – defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Google Gemini – free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional – defaults to gemini-flash-latest
GEMINI_MODEL=

# Optional – provider order, e.g. "gemini,groq". Defaults to "groq,gemini".
LLM_PROVIDERS=
